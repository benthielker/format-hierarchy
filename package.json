{
  "name": "format-hierarchy",
  "author": "Ben Thielker <benthielker@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benthielker/format-hierarchy.git"
  },
  "bugs": {
    "url": "https://github.com/benthielker/format-hierarchy/issues"
  },
  "homepage": "https://github.com/benthielker/format-hierarchy#readme",
  "version": "0.1.0",
  "description": "A lightweight TypeScript / JavaScript utility to format and stringify objects and hierarchies with an emphasis on consuming less space when long lists of short values are present.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "format",
    "hierarchy",
    "stringify",
    "json",
    "depth",
    "pretty-print",
    "tree"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
